# Copie para .env apenas para rodar no computador. No GitHub, use Settings > Secrets and variables.
PORTAL_NAME=PB Minuto
PORTAL_HANDLE=@pbminuto

# auto = publica sozinho | review = espera aprovação
POST_MODE=auto
POSTS_PER_RUN=1
MAX_POSTS_PER_DAY=14
MIN_SOURCES=2
TRUSTED_SINGLE_SOURCE=true
SENSITIVE_MODE=careful
CAROUSEL=true
IMAGE_MODE=none

# IA (Gemini tem plano grátis)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Instagram
IG_USER_ID=
IG_ACCESS_TOKEN=

# Hospedagem das imagens
IMGBB_API_KEY=
